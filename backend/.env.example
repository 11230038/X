# Copy this file to .env and replace every value. The service does not use
# defaults or process environment variables; a complete .env file is required.

# HTTP server
HTTP_ADDR=:8080
APP_ENV=development
SHUTDOWN_TIMEOUT=10s
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=2m
HTTP_WRITE_TIMEOUT=2m
HTTP_IDLE_TIMEOUT=1m

# Local file library. Relative paths are resolved from this .env file.
UPLOAD_ROOT=../data/upload
UPLOAD_MAX_FILE_BYTES=20971520
UPLOAD_MAX_REQUEST_BYTES=22020096

# Authentication. The secret must be at least 32 bytes and must never be
# committed; generate one with: openssl rand -base64 48
# The placeholder below is deliberately too short, so copying this template
# without replacing it stops the service at startup.
AUTH_JWT_SECRET=replace-me
AUTH_JWT_ISSUER=x-backend
AUTH_TOKEN_TTL=24h

# seekdb connection (MySQL protocol; the default seekdb port is 2881)
DB_HOST=127.0.0.1
DB_PORT=2881
DB_NAME=x
DB_USER=root
DB_PASSWORD=replace-with-a-local-password
# DB_COLLATION must be a binary collation. seekdb defaults to utf8mb4_general_ci,
# which would make "Test" and "test" the same username.
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_bin
DB_TLS=false
# CURRENT_TIMESTAMP is evaluated in the session time zone, and seekdb defaults
# that to the host offset, so only UTC is accepted here.
DB_TIMEZONE=UTC
DB_PING_TIMEOUT=3s

# seekdb connection pool
DB_MAX_OPEN_CONNS=20
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=30m
DB_CONN_MAX_IDLE_TIME=5m

# Model provider. DeepSeek speaks the OpenAI-compatible protocol, and the base
# URL accepts both https://api.deepseek.com and https://api.deepseek.com/v1.
# The key must never be committed; the placeholder below stops startup until it
# is replaced.
LLM_PROVIDER=deepseek
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_API_KEY=replace-with-your-deepseek-key
LLM_TIMEOUT=2m

# Short internal calls the user never explicitly asked for (CFG-02): naming a
# session, drafting the home suggestions. Same model is fine to start with.
LLM_TASK_MODEL=deepseek-chat
LLM_TASK_MAX_TOKENS=512

# Per-capability tuning (CFG-01). Every capability and stage named here is
# checked against the registered manifests at startup, so a typo stops the
# service rather than silently falling back. context_budget_tokens is the
# conversation a capability may send in one model call; older messages are
# trimmed from the front once it is exceeded. Single quotes keep the braces out
# of the dotenv parser's way.
LLM_CAPABILITY_CONFIG_JSON='{"chat":{"temperature":0.7,"context_budget_tokens":32000,"stages":{"exploring":{"max_tokens":1024},"responding":{"max_tokens":4096}}}}'

# Turn execution bounds. TURN_INPUT_TIMEOUT caps how long a turn may wait for a
# reply after asking the user something; TURN_MAX_ROUNDS caps agent-loop
# iterations so a tool-calling model cannot spin forever.
#
# TURN_MAX_ATTACHMENT_BYTES is one turn's attachments in total, which is a
# different limit from UPLOAD_MAX_FILE_BYTES: that one bounds a single stored
# file, this one bounds what one message may carry. ATT-03 sets it at 25MB.
TURN_INPUT_TIMEOUT=30m
TURN_MAX_ROUNDS=12
TURN_MAX_ATTACHMENT_BYTES=26214400

# Vision provider. Reserved for later use: nothing in the current slice calls
# it, and the chat model above reads text only, so images are not read by
# anything yet. Ark serves the OpenAI-compatible shape under /api/v3, and as
# with LLM_BASE_URL this value is the prefix, not the endpoint: a client would
# append /chat/completions to it.
#
# The model must be activated in the Ark console before it will answer.
VISION_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
VISION_MODEL=doubao-seed-2-1-lite-260915
VISION_API_KEY=replace-with-your-ark-key
VISION_TIMEOUT=2m
VISION_MAX_TOKENS=1024

# Embedding provider (V2: knowledge base retrieval). Qwen serves the
# OpenAI-compatible shape under /compatible-mode/v1, and like LLM_BASE_URL this
# value is the prefix, not the endpoint: the client appends /embeddings to it.
#
# EMBEDDING_DIMENSION is not a free choice. The schema pins the dimension in the
# vector column, and startup refuses to run when the two disagree; moving to a
# model that returns a different width needs a new migration and a rebuild of
# every knowledge base. 1024 is this model's default (256, 512, 768 and 1024 are
# all selectable, but the schema only has room for one).
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=qwen3.7-text-embedding-flash
EMBEDDING_API_KEY=replace-with-your-dashscope-key
EMBEDDING_DIMENSION=1024
EMBEDDING_TIMEOUT=30s
EMBEDDING_BATCH_SIZE=16

# Document parsing. "text" reads the file as text with this process; "docling"
# sends it to a service that reads PDFs and office documents. The registry check
# at startup refuses any other name, and the docling URL is read (and checked)
# only when docling is the engine selected.
#
# PARSER_TIMEOUT is one external call. A parse that times out fails that
# document as parse_failed; it does not fail the service.
PARSER_DEFAULT_ENGINE=text
PARSER_DOCLING_BASE_URL=http://127.0.0.1:5001
PARSER_TIMEOUT=2m

# Knowledge base chunking, retrieval and indexing. Chunk sizes are in
# characters, not tokens, because that is what a citation points at.
#
# KB_RETRIEVAL_CANDIDATES is how many chunks each branch of the hybrid search
# returns before rank fusion, and KB_RETRIEVAL_TOP_K is how many survive into
# the model's context; candidates must be at least top_k, since fusion can only
# rank what the branches retrieved. KB_RRF_K is the constant in the fusion
# score 1/(k + rank).
#
# The two character budgets are ATT-03: 200k for one document, 150k for the
# text one turn may carry. A document past the first is stored truncated.
#
# KB_VECTOR_LEASE is how long a claimed document may sit in "running" before
# another worker may claim it: too short and two workers embed the same
# document, too long and a crashed worker's document waits that long.
KB_CHUNK_SIZE=512
KB_CHUNK_OVERLAP=50
KB_RETRIEVAL_TOP_K=5
KB_RETRIEVAL_CANDIDATES=20
KB_RRF_K=60
KB_MAX_CHARS_PER_DOCUMENT=200000
KB_MAX_CHARS_PER_TURN=150000
KB_VECTOR_LEASE=5m
KB_INDEX_WORKERS=2
