# 把这份文件复制成 .env，并替换掉每一个取值。服务不使用默认值，
# 也不读进程环境变量；一份完整的 .env 文件是必需的。

# HTTP 服务
HTTP_ADDR=:8080
APP_ENV=development
SHUTDOWN_TIMEOUT=10s
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=2m
HTTP_WRITE_TIMEOUT=2m
HTTP_IDLE_TIMEOUT=1m

# 本地文件库。相对路径以这份 .env 文件所在的位置为基准解析。
UPLOAD_ROOT=../data/upload
UPLOAD_MAX_FILE_BYTES=20971520
UPLOAD_MAX_REQUEST_BYTES=22020096

# 认证。密钥至少 32 字节，且永远不要提交；
# 这样生成一个：openssl rand -base64 48
# 下面这个占位值是故意写短的，
# 所以照抄模板却不替换它，服务会在启动时停下来。
AUTH_JWT_SECRET=replace-me
AUTH_JWT_ISSUER=x-backend
AUTH_TOKEN_TTL=24h

# seekdb 连接（走 MySQL 协议；seekdb 的默认端口是 2881）
DB_HOST=127.0.0.1
DB_PORT=2881
DB_NAME=x
DB_USER=root
DB_PASSWORD=replace-with-a-local-password
# DB_COLLATION 必须是二进制排序规则。seekdb 默认是 utf8mb4_general_ci，
# 那会让 "Test" 和 "test" 被当成同一个用户名。
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_bin
DB_TLS=false
# CURRENT_TIMESTAMP 按会话时区求值，而 seekdb 默认把会话时区设成宿主机
# 的偏移量，所以这里只接受 UTC。
DB_TIMEZONE=UTC
DB_PING_TIMEOUT=3s

# seekdb 连接池
DB_MAX_OPEN_CONNS=20
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=30m
DB_CONN_MAX_IDLE_TIME=5m

# 模型提供方。DeepSeek 说的是 OpenAI 兼容协议，base URL 既接受
# https://api.deepseek.com，也接受 https://api.deepseek.com/v1。
# 密钥永远不要提交；下面这个占位值在替换之前，会让服务
# 停在启动阶段，起不来。
LLM_PROVIDER=deepseek
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_API_KEY=replace-with-your-deepseek-key
LLM_TIMEOUT=2m

# 用户从未显式要求的内部短调用（CFG-02）：给会话命名、起草首页建议。
# 起步阶段用同一个模型就够了。
LLM_TASK_MODEL=deepseek-chat
LLM_TASK_MAX_TOKENS=512

# 按能力调参（CFG-01）。这里写到的每个能力和阶段，
# 启动时都会和已注册的清单逐项核对，所以打错字会让服务停下来，
# 而不是悄悄回退到某个默认行为。
# context_budget_tokens 是一个能力在一次模型调用里允许发送的对话量；
# 超过之后，较早的消息会从最前面开始裁掉。
# 外面包的那对单引号，是为了让花括号绕开 dotenv 解析器。
LLM_CAPABILITY_CONFIG_JSON='{"chat":{"temperature":0.7,"context_budget_tokens":32000,"stages":{"exploring":{"max_tokens":1024},"responding":{"max_tokens":4096}}}}'

# 一轮执行的边界。TURN_INPUT_TIMEOUT 限制一轮在问过用户之后，
# 最多能等多久拿到回复；TURN_MAX_ROUNDS 限制 agent 循环的轮数，
# 免得一个爱调工具的模型无休止地转下去。
#
# TURN_MAX_ATTACHMENT_BYTES 是一轮附件加起来的总量，
# 和 UPLOAD_MAX_FILE_BYTES 是两个不同的限制：后者管的是一份存下来的文件，
# 前者管的是一条消息可以携带多少。ATT-03 把它定在 25MB。
TURN_INPUT_TIMEOUT=30m
TURN_MAX_ROUNDS=12
TURN_MAX_ATTACHMENT_BYTES=26214400

# 视觉模型提供方。留给后续使用：当前这一版没有任何地方调用它，
# 上面的对话模型只读文本，所以图片目前还没有被任何东西读入。
# Ark 在 /api/v3 下提供 OpenAI 兼容的接口形态；和 LLM_BASE_URL 一样，
# 这个值是前缀而不是端点：客户端会在它后面接上
# /chat/completions。
#
# 模型必须先在 Ark 控制台里开通，否则不会应答。
VISION_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
VISION_MODEL=doubao-seed-2-1-lite-260915
VISION_API_KEY=replace-with-your-ark-key
VISION_TIMEOUT=2m
VISION_MAX_TOKENS=1024

# 嵌入模型提供方（V2：知识库检索）。Qwen 在 /compatible-mode/v1 下提供
# OpenAI 兼容的接口形态；和 LLM_BASE_URL 一样，这个值是前缀而不是端点：
# 客户端会在它后面接上 /embeddings。
#
# EMBEDDING_DIMENSION 不是可以随便选的。schema 把向量列的维度写死了，
# 两边不一致时，服务在启动阶段就会拒绝运行；
# 换成返回不同宽度的模型，需要新增一次迁移，并重建每一个知识库。
# 1024 是这个模型的默认值（256、512、768 和 1024 都可以选，
# 但 schema 只留了一个位置）。
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=qwen3.7-text-embedding-flash
EMBEDDING_API_KEY=replace-with-your-dashscope-key
EMBEDDING_DIMENSION=1024
EMBEDDING_TIMEOUT=30s
EMBEDDING_BATCH_SIZE=16

# 文档解析。"text" 用本进程把文件当文本读；
# "docling" 把它发给一个能读 PDF 和 Office 文档的服务。
# 启动时的注册表检查会拒绝其它名字。这一项是必填键，填上它
# 就等于打开 docling 引擎；地址本身只在默认引擎是 docling 时才校验。
#
# PARSER_TIMEOUT 是一次外部调用。解析超时只会让那份文档
# 以 parse_failed 失败，不会让服务失败。
PARSER_DEFAULT_ENGINE=text
PARSER_DOCLING_BASE_URL=http://127.0.0.1:5001
PARSER_TIMEOUT=2m

# 知识库的分块、检索与索引。块的大小单位是字符而不是 token，
# 因为引用指向的就是字符。
#
# KB_RETRIEVAL_CANDIDATES 是混合检索每一路在排名融合之前返回多少块，
# KB_RETRIEVAL_TOP_K 是最后有多少块能进入模型的上下文；
# candidates 必须不小于 top_k，因为融合只能给两路已经取回的东西排名。
# KB_RRF_K 是融合打分
# 1/(k + rank) 里的那个常数。
#
# 两个字符预算是 ATT-03：单份文档 200k，一轮可以携带的文本 150k。
# 超过前一个上限的文档，会以截断后的内容存储。
#
# KB_VECTOR_LEASE 是一份被认领的文档可以在 "running" 上停留多久，
# 超过之后别的 worker 才能认领它：太短，两个 worker 会嵌入同一份
# 文档；太长，崩溃的 worker 留下的文档就要等那么久。
KB_CHUNK_SIZE=512
KB_CHUNK_OVERLAP=50
KB_RETRIEVAL_TOP_K=5
KB_RETRIEVAL_CANDIDATES=20
KB_RRF_K=60
KB_MAX_CHARS_PER_DOCUMENT=200000
KB_MAX_CHARS_PER_TURN=150000
KB_VECTOR_LEASE=5m
KB_INDEX_WORKERS=2
