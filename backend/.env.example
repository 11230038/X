# Copy this file to .env and replace every value. The service does not use
# defaults or process environment variables; a complete .env file is required.

# HTTP server
HTTP_ADDR=:8080
APP_ENV=development
SHUTDOWN_TIMEOUT=10s

# PostgreSQL connection
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=x
DB_USER=x_app
DB_PASSWORD=replace-with-a-local-password
DB_SCHEMA=public
DB_SSLMODE=disable
DB_TIMEZONE=UTC
DB_PING_TIMEOUT=3s

# PostgreSQL connection pool
DB_MAX_OPEN_CONNS=20
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=30m
DB_CONN_MAX_IDLE_TIME=5m
