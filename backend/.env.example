# Copy this file to .env and replace every value. The service does not use
# defaults or process environment variables; a complete .env file is required.

# HTTP server
HTTP_ADDR=:8080
APP_ENV=development
SHUTDOWN_TIMEOUT=10s
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=2m
HTTP_WRITE_TIMEOUT=2m
HTTP_IDLE_TIMEOUT=1m

# Local file library. Relative paths are resolved from this .env file.
UPLOAD_ROOT=../data/upload
UPLOAD_MAX_FILE_BYTES=20971520
UPLOAD_MAX_REQUEST_BYTES=22020096

# Authentication. The secret must be at least 32 bytes and must never be
# committed; generate one with: openssl rand -base64 48
# The placeholder below is deliberately too short, so copying this template
# without replacing it stops the service at startup.
AUTH_JWT_SECRET=replace-me
AUTH_JWT_ISSUER=x-backend
AUTH_TOKEN_TTL=24h

# seekdb connection (MySQL protocol; the default seekdb port is 2881)
DB_HOST=127.0.0.1
DB_PORT=2881
DB_NAME=x
DB_USER=root
DB_PASSWORD=replace-with-a-local-password
# DB_COLLATION must be a binary collation. seekdb defaults to utf8mb4_general_ci,
# which would make "Test" and "test" the same username.
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_bin
DB_TLS=false
# CURRENT_TIMESTAMP is evaluated in the session time zone, and seekdb defaults
# that to the host offset, so only UTC is accepted here.
DB_TIMEZONE=UTC
DB_PING_TIMEOUT=3s

# seekdb connection pool
DB_MAX_OPEN_CONNS=20
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=30m
DB_CONN_MAX_IDLE_TIME=5m

# Model provider. DeepSeek speaks the OpenAI-compatible protocol, and the base
# URL accepts both https://api.deepseek.com and https://api.deepseek.com/v1.
# The key must never be committed; the placeholder below stops startup until it
# is replaced.
LLM_PROVIDER=deepseek
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_API_KEY=replace-with-your-deepseek-key
LLM_TIMEOUT=2m

# Short internal calls the user never explicitly asked for (CFG-02): naming a
# session, drafting the home suggestions. Same model is fine to start with.
LLM_TASK_MODEL=deepseek-chat
LLM_TASK_MAX_TOKENS=512

# Per-capability tuning (CFG-01). Every capability and stage named here is
# checked against the registered manifests at startup, so a typo stops the
# service rather than silently falling back. Single quotes keep the braces out
# of the dotenv parser's way.
LLM_CAPABILITY_CONFIG_JSON='{"chat":{"temperature":0.7,"stages":{"exploring":{"max_tokens":1024},"responding":{"max_tokens":4096}}}}'

# Turn execution bounds. TURN_INPUT_TIMEOUT caps how long a turn may wait for a
# reply after asking the user something; TURN_MAX_ROUNDS caps agent-loop
# iterations so a tool-calling model cannot spin forever.
TURN_INPUT_TIMEOUT=30m
TURN_MAX_ROUNDS=12
